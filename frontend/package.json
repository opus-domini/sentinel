{
  "name": "sentinel-frontend",
  "private": true,
  "version": "0.11.3",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "dev:host": "vite dev --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "node ./scripts/run-vitest.mjs run --passWithNoTests --exclude \"src/**/*.e2e.test.ts?(x)\"",
    "test:e2e": "node ./scripts/run-vitest.mjs run --passWithNoTests --config vitest.e2e.config.ts",
    "test:all": "npm run test:unit && npm run test:e2e",
    "typecheck": "tsc",
    "lint": "oxlint . --deny-warnings && oxfmt --check .",
    "format": "oxfmt --write .",
    "fix": "oxfmt --write . && oxlint --fix .",
    "check": "npm run typecheck && npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.3",
    "cronstrue": "^3.38.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "~31.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
